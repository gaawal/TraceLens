DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# 开发/局域网部署可以用 *；生产环境请改成明确域名或 IP。
DJANGO_ALLOWED_HOSTS=*
# 局域网调试默认允许任意前端来源。生产环境建议关闭并填写白名单。
DJANGO_CORS_ALLOW_ALL_ORIGINS=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=
SQLITE_PATH=db.sqlite3
TRACELENS_LOG_DIR=runtime
TRACELENS_LOG_LEVEL=INFO

# 推荐显式配置。可以使用下面命令生成：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRACELENS_CREDENTIAL_KEY=

TRACELENS_SSH_CONNECT_TIMEOUT=10
TRACELENS_SSH_AUTO_ADD_HOST_KEY=true
TRACELENS_KNOWN_HOSTS_FILE=
TRACELENS_SSH_KEEPALIVE=30
# SSH 连接池：无人使用超过 120 秒自动断开；后台每 15 秒主动回收一次。
TRACELENS_SSH_SESSION_IDLE_TIMEOUT=120
TRACELENS_SSH_SESSION_REAP_INTERVAL=15
TRACELENS_SSH_SESSION_MAX=32
# 部署命令连续多少秒没有 stdout/stderr 时，认为 SSH/远程命令卡死并主动断开。
TRACELENS_DEPLOYMENT_SSH_IDLE_OUTPUT_TIMEOUT=300

# Redis 日志索引/正文缓存（Redis 不可用时自动回退远程 SSH 读取）
TRACELENS_REDIS_ENABLED=true
# 推荐：分项配置。Redis 有 requirepass 时填写 TRACELENS_REDIS_PASSWORD。
TRACELENS_REDIS_HOST=127.0.0.1
TRACELENS_REDIS_PORT=6379
TRACELENS_REDIS_DB=0
TRACELENS_REDIS_USERNAME=
TRACELENS_REDIS_PASSWORD=
# 可选：URL 优先于 HOST/PORT/DB；也支持 redis://:password@127.0.0.1:6379/0
TRACELENS_REDIS_URL=
TRACELENS_REDIS_CONNECT_TIMEOUT=1.0
TRACELENS_REDIS_SOCKET_TIMEOUT=2.0
TRACELENS_REDIS_RETRY_SECONDS=30
# 文件指纹/时间范围索引默认保留 30 天
TRACELENS_LOG_INDEX_TTL=2592000
TRACELENS_LOG_INDEX_HEAD_BYTES=131072
TRACELENS_LOG_INDEX_TAIL_BYTES=262144
# 日志正文按查询时间窗压缩缓存，默认 2 小时；单片最大 16 MiB
TRACELENS_LOG_CONTENT_CACHE_TTL=7200
TRACELENS_LOG_CONTENT_CACHE_MAX_BYTES=16777216
# Python 源码与 AST 函数索引缓存，默认 1 小时
TRACELENS_SOURCE_CACHE_TTL=3600

# docker-compose Redis 最大内存，达到上限按 allkeys-lru 淘汰
TRACELENS_REDIS_MAXMEMORY=2gb

TRACELENS_CPD_SNAPSHOT_TTL=2592000
TRACELENS_RUNTIME_STATUS_TTL=60
# 下位机与上位机时间偏差超过该秒数时提示同步（日志时间线保护）
TRACELENS_LOWER_TIME_SYNC_TOLERANCE_SECONDS=60

# CPD report parallelism (bounded)
TRACELENS_CPD_SCAN_WORKERS=4
TRACELENS_CPD_PARSE_WORKERS=6

# Web / deployment process separation
# Docker production web worker count. Deployment SSH commands never run in these workers.
TRACELENS_WEB_WORKERS=4
# Number of deployment tasks that the dedicated deployment-worker may execute concurrently.
TRACELENS_DEPLOYMENT_WORKER_CONCURRENCY=4
TRACELENS_DEPLOYMENT_WORKER_POLL_SECONDS=0.5
# manage.py runserver automatically starts a separate deployment_worker process by default.
TRACELENS_DEPLOYMENT_AUTO_WORKER=true
# Legacy-only fallback; keep false when using the dedicated worker.
TRACELENS_DEPLOYMENT_EMBEDDED_SCHEDULER=false

# AI 用例诊断（兼容 OpenCode 中 @ai-sdk/openai-compatible 的 provider 配置）
TRACELENS_AI_PROVIDER=my-llm
TRACELENS_AI_MODEL=GLM-4.7-XS
TRACELENS_AI_BASE_URL=http://xxxx:3000/v1
TRACELENS_AI_API_KEY=xxxx
TRACELENS_AI_TIMEOUT=600
# 可选：LLM 专用代理。留空表示不显式使用代理。
TRACELENS_AI_PROXY=
# 默认 false：不读取系统 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY，直接访问内网模型网关。
TRACELENS_AI_USE_ENV_PROXY=false
# Agent 每次送入模型的日志行数上限；会优先保留 ERROR/WARN/关键字附近上下文。
TRACELENS_AI_MAX_LOG_ROWS=220
# 前端“当前已采集消息”最多带入的行数。
TRACELENS_AI_MAX_CLIENT_ROWS=260
# 单次 LLM 调用允许携带的日志上下文字符预算。
TRACELENS_AI_MAX_CONTEXT_CHARS=120000
# 单次 AI 最多保留多少个“异常规则命中”的去重证据节点
TRACELENS_AI_MAX_EVIDENCE_NODES=24
# 上述关键证据节点送入模型前的总字符预算
TRACELENS_AI_MAX_EVIDENCE_CHARS=18000
# 自动化用例 AI 诊断 Redis 结果缓存，默认 7 天；同一失败现场再次诊断直接复用
TRACELENS_ATLOG_AI_CACHE_TTL=604800

# TracePilot 本地语音服务。语音输入需要 STT/ASR；TTS 预留给后续朗读 AI 回答。
# STT 接口：multipart/form-data，默认文件字段 file；返回 JSON 中 text/transcript/data.text/result.text 任一均可。
TRACELENS_VOICE_STT_URL=
TRACELENS_VOICE_STT_API_KEY=
TRACELENS_VOICE_STT_MODEL=
TRACELENS_VOICE_STT_LANGUAGE=zh
TRACELENS_VOICE_STT_FILE_FIELD=file
TRACELENS_VOICE_STT_TIMEOUT=90
TRACELENS_VOICE_STT_MAX_BYTES=26214400
TRACELENS_VOICE_STT_USE_ENV_PROXY=false
# 仅预留，当前版本不自动朗读 AI 回复。
TRACELENS_VOICE_TTS_URL=
